# Maintainer: Aleksandr Silaev <sasasilaev27@gmail.com>

pkgname=iutf
pkgver=0.6.2
pkgrel=1
pkgdesc="Int Unified Text Format - SOURCES of IUTF"
arch=('x86_64')
url="https://github.com/gnom2949/IUTF"
license=('Apache-2.0')
depends=('glib2')
makedepends=('meson' 'ninja' 'gcc')
source=("git+https://github.com/gnom2949/IUTF.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
	cd "$pkgname"
	meson setup build --prefix=/usr --libdir=lib
	ninja -C build
}

check() {
	cd "$pkgname"
	ninja -C build test
}

package() {
	cd "$pkgname"
	DESTDIR="$pkgname" ninja -C build install
}